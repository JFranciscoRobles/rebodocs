{
  "name": "rebodocs",
  "version": "0.10.0",
  "description": "A word processor for the browser, compatible with Word (DOCX) files, with its own engine: layout, editing, collaboration, PDF and templates.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @rebodocs/playground",
    "demo": "npm run dev -w @rebodocs/demo",
    "build:demo": "npm run build -w @rebodocs/demo",
    "storage": "npm run dev -w @rebodocs/storage-demo",
    "realtime": "npm run dev -w @rebodocs/realtime-demo",
    "assistant": "npm run dev -w @rebodocs/assistant-demo",
    "crm": "npm run dev -w @rebodocs/crm-demo",
    "desktop": "npm run dev -w @rebodocs/desktop",
    "build:desktop": "npm run build -w @rebodocs/desktop",
    "build": "npm run build -w @rebodocs/playground",
    "test": "vitest run --project node",
    "test:browser": "vitest run --project browser",
    "coverage": "vitest run --project node --coverage --coverage.include='packages/*/src/**'",
    "lint": "biome check .",
    "api": "node tools/api-report.mjs",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/demo && tsc --noEmit -p apps/storage && tsc --noEmit -p apps/realtime && tsc --noEmit -p apps/assistant && tsc --noEmit -p apps/crm",
    "word-compare": "node tools/word-compare.mjs",
    "a11y": "node tools/a11y-audit.mjs",
    "generate": "vite-node packages/mcp/src/generate.ts --",
    "mcp": "node packages/mcp/bin/rebodocs-mcp.mjs",
    "float-cases": "vite-node tools/float-cases.ts --",
    "contract-cases": "vite-node tools/contract-cases.ts --",
    "eval:assistant": "vite-node tools/assistant-eval/run.ts --",
    "bench": "vite-node tools/bench.ts --",
    "word-check": "node tools/word-compare.mjs test-documents --expect",
    "locale": "vite-node tools/locale.ts --",
    "collab": "node packages/collab/bin/rebodocs-collab.mjs",
    "site": "npm run build -w @rebodocs/react && npm run dev -w @rebodocs/site",
    "build:site": "npm run build -w @rebodocs/react && npm run build -w @rebodocs/site",
    "build:react": "npm run build -w @rebodocs/react && npm pack -w @rebodocs/react --pack-destination packages/react",
    "build:packages": "npm run build -w @rebodocs/core -w @rebodocs/editor -w @rebodocs/collab -w @rebodocs/mcp",
    "build:mcp": "npm run build -w @rebodocs/mcp"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "~0.137.0",
    "@biomejs/biome": "2.5.15",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "axe-core": "^4.10.3",
    "linkedom": "0.18.14",
    "playwright": "^1.64.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-node": "^6.0.0",
    "vitest": "^5.0.5"
  }
}
