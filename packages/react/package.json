{
  "name": "@rebodocs/react",
  "version": "0.5.6",
  "description": "The DOCX editor as a React component, or as headless hooks, with everything it needs inside.",
  "license": "MIT",
  "homepage": "https://rebodocs.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JFranciscoRobles/rebodocs.git",
    "directory": "packages/react"
  },
  "bugs": "https://github.com/JFranciscoRobles/rebodocs/issues",
  "keywords": [
    "docx",
    "word",
    "editor",
    "word-processor",
    "react",
    "nextjs",
    "pdf",
    "collaboration",
    "templates"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/react/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/react/src/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mount": {
      "types": "./dist/react/src/mount.d.ts",
      "import": "./dist/mount.js"
    }
  },
  "scripts": {
    "build": "vite build && node scripts/types.mjs",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18"
  }
}
