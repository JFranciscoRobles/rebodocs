{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rebodocs",
  "version": "0.9.0",
  "identifier": "com.rebodocs.desktop",
  "build": {
    "beforeDevCommand": "npm run web",
    "devUrl": "http://localhost:5178",
    "beforeBuildCommand": "npx vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "dangerousDisableAssetCspModification": ["style-src"],
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "A word processor for .docx files",
    "copyright": "MIT",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "fileAssociations": [
      {
        "ext": ["docx"],
        "name": "Word document",
        "description": "Word document",
        "mimeType": "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "role": "Editor",
        "rank": "Alternate"
      }
    ]
  }
}
