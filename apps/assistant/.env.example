# The key of the Claude API, from https://platform.claude.com. Without it the
# chat says so, and the rest of the demo works as the realtime one does.
ANTHROPIC_API_KEY=

# The model, how hard it thinks (low, medium, high), and how many steps one
# address may ask for in a minute: each tool the assistant uses is a step.
# ASSISTANT_MODEL=claude-opus-5-5
# ASSISTANT_EFFORT=medium
# ASSISTANT_PER_MINUTE=40

# The documents are kept in ./documents. To keep them in an S3 bucket instead,
# give the same names `apps/storage` takes:
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=rebodocs-demo
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Where its collaboration server listens: not the realtime demo's, so both run at once.
# COLLAB_PORT=7431
# COLLAB_HOST=0.0.0.0
