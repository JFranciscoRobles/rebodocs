{
  "name": "@rebodocs/assistant-demo",
  "version": "0.11.0",
  "description": "Claude in the editor: a chat beside a shared document that reads and changes it, with its look kept, and the others in the room seeing it happen.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "sample": "node -e \"fs.mkdirSync('.seed', { recursive: true })\" && vite-node ../demo/scripts/sample.ts .seed/contract.docx",
    "dev": "npm run sample && vite",
    "build": "tsc --noEmit && vite build"
  },
  "dependencies": {
    "@rebodocs/core": "^0.11.0",
    "@rebodocs/react": "^0.11.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@rebodocs/collab": "^0.11.0",
    "@rebodocs/mcp": "^0.11.0",
    "@vitejs/plugin-react": "^6.1.1"
  }
}
