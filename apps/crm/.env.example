# The key of the Claude API, from https://platform.claude.com. Without it the
# assistant says so, and the rest of the demo works.
ANTHROPIC_API_KEY=

# The model, how hard it thinks (low, medium, high), and how many steps one
# address may ask for in a minute: each tool the assistant uses is a step.
# ASSISTANT_MODEL=claude-sonnet-5-5
# ASSISTANT_EFFORT=medium
# ASSISTANT_PER_MINUTE=40
