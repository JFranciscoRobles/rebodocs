# Copy to .env and fill in. The file stays out of git.

# Cloudflare R2: the S3 API address of your account, and "auto" for the region.
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=rebodocs-demo
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# AWS S3: leave S3_ENDPOINT out, and give the region of the bucket.
# MinIO and others that take the bucket in the path, not in the host name:
# S3_FORCE_PATH_STYLE=true

# Where .ttf files are, for the PDF. Without it, the fonts of the system.
# FONTS_DIR=./fonts
