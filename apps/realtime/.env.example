# Nothing here is needed: without a .env the documents are kept in ./documents.

# To keep them in an S3 bucket instead, give the same names `apps/storage` takes:
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=rebodocs-demo
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Where the collaboration server listens, and on what address. To let other
# machines of the network in, COLLAB_HOST=0.0.0.0 and `npm run realtime -- --host`.
# COLLAB_PORT=7421
# COLLAB_HOST=0.0.0.0
