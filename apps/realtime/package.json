{
  "name": "@rebodocs/realtime-demo",
  "version": "0.10.0",
  "description": "Several people on one document at once: the collaboration server, a backend that keeps the documents and says who may come in, and the page.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "sample": "node -e \"fs.mkdirSync('.seed', { recursive: true })\" && vite-node ../demo/scripts/sample.ts .seed/contract.docx",
    "dev": "npm run sample && vite",
    "build": "tsc --noEmit && vite build"
  },
  "dependencies": {
    "@rebodocs/core": "^0.10.0",
    "@rebodocs/react": "^0.10.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@rebodocs/collab": "^0.10.0",
    "@vitejs/plugin-react": "^6.1.1"
  }
}
